# consult2elm configuration -- installed as /etc/consult2elm.conf

[consult]
# CONSULT-to-USB adapter (FTDI based cables show up as /dev/ttyUSB0).
# Use /dev/serial/by-id/... for a name that never changes.
serial_port = /dev/ttyUSB0
baudrate = 9600
# Seconds without a frame before values count as stale ("NO DATA").
stale_after = 2

[obd]
# bluetooth = RFCOMM/SPP server for the FMB130, tcp = like a Wi-Fi ELM327 (testing)
transport = bluetooth
bt_name = OBDII
bt_channel = 1
# Leave "yes" until the FMB130 has paired once, then set "no": the tracker
# reconnects by MAC address and the Pi stops answering Bluetooth scans.
bt_discoverable = yes
# Bluetooth device class. 0x001F00 ("Uncategorized") is what real ELM327
# dongles report; BlueZ's default makes the Pi invisible to some phones.
bt_class = 0x001F00
bt_setup = yes
tcp_port = 35000
# Vehicle VIN reported to the tracker (OBD mode 09 PID 02). The 1997 ECU has
# none, so leave empty for "NO DATA" or enter the 17 characters from the car.
vin =
# Close a client's Bluetooth link after this many seconds without a request
# (0 = never). The FMB130 can stop polling after "ATPC" while keeping the link
# open; when the link drops it reconnects and starts polling again.
idle_disconnect = 120

[power]
# rpm = only a running engine counts as activity (ignition on, engine off -> sleep)
# ecu = any answer from the ECU (ignition on) counts as activity
wake_on = rpm
# Seconds without activity before the low-power mode starts.
idle_after = 120
# In low-power mode, how often the ECU is probed for RPM.
probe_interval = 5
# Take CPU cores 1-3 offline and use the powersave governor while sleeping.
cpu_saving = yes
# Seconds without activity before halting the Pi (0 = never).
# Only enable this with a wake-up circuit on GPIO3 or a switched supply (README).
shutdown_after = 0
shutdown_command = systemctl poweroff

[general]
simulate = no
log_level = INFO
# Log file written by the program itself (kept across reboots and power cuts).
log_file = /var/log/consult2elm.log
# Show the state on the green ACT LED (see README "Status LED").
status_led = yes
